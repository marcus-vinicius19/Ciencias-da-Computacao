def calculadora(x:String, y:Int, z:Int): String = x match{
  case x if (x=="+") => return (y+z).toString
  case x if (x=="-")  => return (y-z).toString
  case x if (x=="/")  => return(y/z).toString
  case x if (x=="*")  => return (y*z).toString
  case _ => return "Operação Inválida"
}
println(calculadora("+", 1,1))




