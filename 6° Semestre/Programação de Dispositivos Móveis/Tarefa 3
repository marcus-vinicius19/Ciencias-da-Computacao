fun fibonacci(n: Int): Int {
    if (n == 0) return 0
    if (n == 1) return 1 
    
    var a = 0
    var b = 1
    var resultado = 1

    for (i in 2..n) {
        resultado = a + b
        a = b
        b = resultado
    }

    return resultado
}

fun main() {
    println("Entre com um número inteiro positivo: ")
    val n = readLine()?.toIntOrNull()

      if (n != null && n >= 0) {
        val fib = fibonacci(n)
        println("O valor de Fibonacci para $n é: $fib")
    } else {
        println("Entrada inválida! Por favor, insira um número inteiro positivo.")
    }
}


