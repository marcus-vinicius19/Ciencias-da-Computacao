fun saudacao(nome: String?, idade: Int? ): String {
    if(idade in 18..65){
        return ("Olá, " + nome + " ! " + "Você tem " + idade + " anos!" + " Você pode doar sangue")
    }
    else{
        return ("Olá, " + nome + " ! " + "Você tem " + idade + " anos!" + " Você não pode doar sangue")
    }
   
}

fun main(){
    val nome: String?
    val idade: Int?

    println("Entre com o seu nome: ")
    nome = readLine()

    println("Entre com sua idade: ")
    idade = readLine()?.toIntOrNull()

    val retorno = saudacao(nome, idade)
    println (retorno)

}

