fun INDICEMC(peso: Double?, altura: Double?): Double {
    // Verifica se peso e altura não são nulos
    if (peso == null || altura == null) {
        println("Peso ou altura inválidos.")
        return 0.0
    }
    return peso / (altura * altura)
}

fun main() {
    println("Entre com o peso (kg): ")
    val peso = readLine()?.toDoubleOrNull()
    println(peso)
    
    println("Entre com a altura (m): ")
    val altura = readLine()?.toDoubleOrNull()
    println(altura)
    
    val imc = INDICEMC(peso, altura)

    // Verifica se o IMC é válido (diferente de 0.0)
    if (imc != 0.0) {
        println("Seu Índice de Massa Corporal é: %.2f".format(imc))
    } else {
        println("Não foi possível calcular o IMC. Verifique os valores inseridos.")
    }
}

