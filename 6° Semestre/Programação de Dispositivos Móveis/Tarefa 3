fun soma2Numeros(a: Int?, b: Int?): Int {
    if (a == null || b == null) {
        println("Um dos valores é nulo.")
        return 0
    }
    return a + b
}

fun main() {
    println("Entre com o primeiro número: ")
    val a = readLine()?.toIntOrNull()

    println("Entre com o segundo número: ")
    val b = readLine()?.toIntOrNull()

    val retorno = soma2Numeros(a, b)
    println("A soma é: $retorno")
}


