fun fatorial(n: Int): Int{
    var resultado: Int = 1
    for (i in 1..n) {
        resultado *= i
    }

    return resultado
}

fun main() {
    println("Entre com um número inteiro positivo: ")
    val n = readLine()?.toIntOrNull()

    if (n != null && n >= 0) {
        val fat = fatorial(n)
        println("O fatorial de $n é: $fat")
    } else {
        println("Entrada inválida! Por favor, insira um número inteiro positivo.")
    }
}


