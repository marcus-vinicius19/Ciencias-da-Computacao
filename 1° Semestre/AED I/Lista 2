#include<stdio.h>
#include<locale.h>

int main() {
	setlocale(LC_ALL, "Portuguese");
	
	int i, A[10], media, maior=0, menor;

	printf("Inicio de programa");
	
	printf("\nEntre com 10 números inteiros: \n");
	
	for (i=0; i<10; i++){
		scanf("%d", &A[i]);}
		
	menor = A[0];

	for (i=0; i<10; i++){
	if (A[i]>=maior)
	maior = A[i]; }
	
	for (i=0; i<10; i++){
	if (A[i]<= menor)
	menor = A[i]; }
	
	media = (maior+menor)/2;
	
printf("A média do maior e menor números entrados é: %d\n", media);		
	printf("\nFim do programa\n");
	return 0;
	
}





