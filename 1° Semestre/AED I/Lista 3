				j++;
			}
		}
	}
	int array2[j];
	j=0;
	for(i=0;i<10;i++){
		for(i2=0;i2<10;i2++){
			if(array[i]==array[i2]){
				array2[j]=array[i];
				j++;
			}
		}
	}
	for(i=0;i<j;i++){
		printf("\n%d",array2[i]);
	}
