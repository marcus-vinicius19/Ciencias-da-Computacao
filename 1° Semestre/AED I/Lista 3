int main() {
	setlocale(LC_ALL, "Portuguese");
	
	int clientes=150,pagamento[3],ValorC=0,ValorCC=0,ValorCe=0, i=0;		
	double valor[3], cheque=0, cartao=0, cedulas=0, total=0;
//cheque é o pagamento 1, cartão o pagamento 2 e cédulas o pagamento 3;

	for(i=0; i<clientes; i++){
		printf("Entre com o tipo de pagamento: \n");
		scanf("%d", &pagamento[i]); 
		printf("Entre com o valor pago: \n");
		scanf("%lf", &valor[i]);
}
		
   for (i=0;i<clientes; i++)
	 switch(pagamento[i]){
	 	case 1:
	 		ValorC++;
	 		cheque += valor[i];
	 		break;
	 	case 2:
	 		ValorCC++;
	 		cartao += valor[i];
	 		break;
	 	default:
	 		ValorCe++;
	 		cedulas += valor[i];
	 		break;	 
	 }
	 
	 total = cedulas+cartao+cheque;
	 
		printf("O valor obtido em cédulas foi de: R$%lf\n", cedulas);
		printf("O valor obtido em cartão foi de: R$%lf\n", cartao);
		printf("O valor obtido em cheque foi de: R$%lf\n", cheque);
 		printf("O valor total obtido foi de: R$%lf\n", total);
	
	return 0;
}



