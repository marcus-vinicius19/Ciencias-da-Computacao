#include <stdio.h>

int fib (int n) {
   int aux1 = 0;
   int aux2 = 1;
   int retorno=0;
 
   
for (int i = 2; i <= n; i++){
   
   retorno = aux1 + aux2 ;
   aux1 = aux2;
   aux2 = retorno;
   
   
}
return retorno;


}


int main()
{
    int n, aux;
   
    printf("Digite o valor de n: ");
    scanf ("%d", &n);
   
     aux = fib(n);
   
    printf ("\n\nO valor retornado é %d", aux);

    return 0;
   
}

