int fib (int n) {
   
    printf("\nDentro da função fib n=%d", n);

   if(n == 0)  return 0;
   
    if(n == 1)  return 1;
       
    if(n > 1)  return fib(n-1) + fib(n-2);

}

int main()
{
    int n, aux;
   
    printf("Digite o valor de n: ");
    scanf ("%d", &n);
   
     aux = fib(n);
   
    printf ("\n\nO valor retornado é %d", aux);

    return 0;
   
}
