11.
CREATE TRIGGER Dependente_10
AFTER INSERT ON dependente
FOR EACH ROW
AS
BEGIN
    UPDATE Empregados SET salario = salario * 1,1
Where dependente.cod_empregado = Empregados.cod_empregado
END


12.
CREATE TRIGGER XCLD	
AFTER DELETE ON Dependente
AS
BEGIN
    UPDATE Empregados SET salario = salario - (salario*0,1)
Where dependente.cod_empregado = Empregados.cod_empregado
END

